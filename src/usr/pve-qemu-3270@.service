[Unit]
Description=PVE 3270 console sessions (VM %i)
BindsTo=%i.scope
After=%i.scope

[Service]
Slice=qemu.slice
Type=oneshot
RemainAfterExit=yes
# c3270 reads no profile, and the pager of its information screens runs no commands
Environment=LANG=C.UTF-8 HOME=/root NOC3270PRO=1 LESSSECURE=1
ExecStart=/usr/libexec/qemu-server/3270-sessions %i
ExecReload=/usr/libexec/qemu-server/3270-sessions %i
# the tmux server is killed with the unit and leaves its socket behind
ExecStopPost=/bin/rm -f /run/qemu-server/%i.3270.tmux
# c3270 only talks to QEMU and the tmux server only to its clients, over Unix sockets
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/run/qemu-server
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
